{
  "manifest_version": 3,
  "name": "B站视频过滤器",
  "version": "0.8.3",
  "description": "仅在B站首页推荐流中按关键词、播放量、UP主粉丝数和特殊话题过滤视频，不干扰搜索和UP主空间。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "过滤设置与标记库"
  },
  "options_ui": {"page": "feed.html", "open_in_tab": true},
  "content_scripts": [{
    "matches": ["https://www.bilibili.com/*"],
    "js": ["page-adapter.js", "home-layout.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_start"
  }],
  "background": {
    "service_worker": "background.js"
  }
}
