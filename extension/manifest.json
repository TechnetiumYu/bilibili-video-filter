{
  "manifest_version": 3,
  "name": "B站视频过滤器",
  "version": "0.9.0",
  "description": "极简独立视频界面与B站首页过滤，支持可折叠筛选栏、话题门槛、标记和连续加载。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "打开 B站视频过滤器"
  },
  "options_ui": {"page": "feed.html", "open_in_tab": true},
  "content_scripts": [{
    "matches": ["https://www.bilibili.com/*"],
    "js": ["page-adapter.js", "home-layout.js", "carousel-filter.js", "home-stream.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_start"
  }],
  "background": {
    "service_worker": "background.js"
  }
}
