{
  "manifest_version": 3,
  "name": "B站视频过滤器",
  "version": "0.6.0",
  "description": "高速过滤B站推荐流、稳妥过滤搜索结果，支持无限滚动、412续跑和标记样本。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "打开 B站视频过滤器"
  },
  "background": {
    "service_worker": "background.js"
  }
}
